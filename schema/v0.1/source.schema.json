{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:c2atrace:schema:v0.1:source",
  "title":"C2ATrace v0.1 Source",
  "$defs":{
    "AliasAssertion":{
      "type":"object",
      "required":["id","target"],
      "properties":{
        "id":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Id"},
        "target":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
        "asserted_by":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/PrincipalRef"},
        "basis":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}}
      },
      "additionalProperties":false
    },
    "ResolutionHop":{
      "type":"object",
      "required":["from_locator","to_locator","relation"],
      "properties":{
        "from_locator":{"type":"string","minLength":1},
        "to_locator":{"type":"string","minLength":1},
        "relation":{"enum":["redirect","resolution","unknown"]},
        "metadata":{"type":"object","additionalProperties":true}
      },
      "additionalProperties":false
    },
    "SourceRef":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","source_kind"],
          "properties":{
            "kind":{"const":"SourceRef"},
            "source_kind":{"type":"string","minLength":1},
            "locators":{"type":"array","items":{"type":"string","minLength":1}},
            "aliases":{"type":"array","items":{"$ref":"#/$defs/AliasAssertion"}}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "SourceObservation":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","source_ref","observation_extent"],
          "properties":{
            "kind":{"const":"SourceObservation"},
            "source_ref":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "requested_locator":{"type":"string","minLength":1},
            "effective_locator":{"type":"string","minLength":1},
            "resolution_hops":{"type":"array","items":{"$ref":"#/$defs/ResolutionHop"}},
            "representation":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/Representation"},
            "content_commitments":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Commitment"}},
            "observed_at":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Timestamp"},
            "external_version_hints":{"type":"object","additionalProperties":true},
            "capture_target":{
              "type":"object",
              "required":["description"],
              "properties":{
                "description":{"type":"string","minLength":1},
                "profile_id":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/ProfileId"}
              },
              "additionalProperties":false
            },
            "observation_extent":{"enum":["complete","partial","unknown"]}
          },
          "unevaluatedProperties":false
        }
      ]
    }
  }
}
