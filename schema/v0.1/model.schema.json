{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:c2atrace:schema:v0.1:model",
  "title":"C2ATrace v0.1 Model Invocation and Output",
  "$defs":{
    "ModelInvocation":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","lifecycle_state"],
          "properties":{
            "kind":{"const":"ModelInvocation"},
            "lifecycle_state":{"enum":["active","terminal","unknown"]},
            "terminal_disposition":{"enum":["output_accepted","failed","cancelled","abandoned","unknown"]},
            "requested_model":{"type":"string","minLength":1},
            "accepted_output":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "started_at":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Timestamp"},
            "ended_at":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Timestamp"},
            "metadata":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/MetadataEntry"}}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "EffectiveRequest":{
      "type":"object",
      "required":["capture_level","snapshot"],
      "properties":{
        "capture_level":{"enum":["sdk_arguments","provider_payload","prepared_http_body","unknown"]},
        "snapshot":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}
      },
      "additionalProperties":false
    },
    "ProviderAttempt":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","invocation","lifecycle_state"],
          "properties":{
            "kind":{"const":"ProviderAttempt"},
            "invocation":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "lifecycle_state":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/LifecycleState"},
            "terminal_disposition":{"enum":["completed","failed","timeout","cancelled","interrupted","unknown"]},
            "effective_requests":{"type":"array","items":{"$ref":"#/$defs/EffectiveRequest"}},
            "retry_of":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "failover_from":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "hedged_with":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}},
            "effective_requested_model":{"type":"string","minLength":1},
            "provider":{"type":"string","minLength":1},
            "started_at":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Timestamp"},
            "ended_at":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Timestamp"},
            "metadata":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/MetadataEntry"}}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "ModelOutput":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","attempt","item_refs","response_termination","capture_extent"],
          "properties":{
            "kind":{"const":"ModelOutput"},
            "attempt":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "item_refs":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}},
            "response_termination":{"enum":["complete","incomplete","unknown"]},
            "capture_extent":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/CaptureExtent"},
            "representation":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/Representation"},
            "provider_reported_model":{"type":"string","minLength":1},
            "metadata":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/MetadataEntry"}}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "OutputItemBase":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {"type":"object","required":["output"],"properties":{"output":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},"ordinal":{"type":"integer","minimum":0}}}
      ]
    },
    "TextOutput":{
      "allOf":[
        {"$ref":"#/$defs/OutputItemBase"},
        {
          "type":"object",
          "required":["kind","text"],
          "properties":{
            "kind":{"const":"TextOutput"},
            "text":{"type":"string"},
            "commitments":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Commitment"}}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "StructuredOutput":{
      "allOf":[
        {"$ref":"#/$defs/OutputItemBase"},
        {
          "type":"object",
          "required":["kind","value"],
          "properties":{
            "kind":{"const":"StructuredOutput"},
            "value":true,
            "schema_ref":{"type":"string","minLength":1},
            "commitments":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Commitment"}}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "UnknownOutput":{
      "allOf":[
        {"$ref":"#/$defs/OutputItemBase"},
        {
          "type":"object",
          "required":["kind"],
          "properties":{
            "kind":{"const":"UnknownOutput"},
            "representation":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/Representation"}
          },
          "unevaluatedProperties":false
        }
      ]
    }
  }
}
