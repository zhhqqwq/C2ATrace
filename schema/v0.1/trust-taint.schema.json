{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:c2atrace:schema:v0.1:trust-taint",
  "title":"C2ATrace v0.1 Trust and Taint",
  "$defs":{
    "TrustAssertion":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","subject","dimension","state","asserted_by","policy"],
          "properties":{
            "kind":{"const":"TrustAssertion"},
            "subject":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/Subject"},
            "dimension":{"type":"string","minLength":1},
            "state":{"enum":["trusted","untrusted","unknown"]},
            "asserted_by":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/PrincipalRef"},
            "policy":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/PolicyRef"},
            "basis":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "TaintAssertion":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","subject","taint_kind","state","channel","precision","basis_kind","asserted_by","policy"],
          "properties":{
            "kind":{"const":"TaintAssertion"},
            "subject":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/Subject"},
            "taint_kind":{"type":"string","minLength":1},
            "state":{"enum":["present","absent","unknown"]},
            "channel":{"enum":["content","control","mixed","unknown"]},
            "precision":{"enum":["exact","conservative","unknown"]},
            "basis_kind":{"enum":["direct","propagated","sanitization","unknown"]},
            "asserted_by":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/PrincipalRef"},
            "policy":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/PolicyRef"},
            "basis":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}},
            "transform":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "upstream_taint":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}}
          },
          "unevaluatedProperties":false
        }
      ]
    }
  }
}
