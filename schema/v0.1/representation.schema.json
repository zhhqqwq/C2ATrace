{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:c2atrace:schema:v0.1:representation",
  "title":"C2ATrace v0.1 Representation, Region, and Record Base",
  "$defs":{
    "Extensions":{"type":"object","propertyNames":{"type":"string","minLength":1},"additionalProperties":true},
    "BaseRecord":{
      "type":"object",
      "required":["id","kind"],
      "properties":{
        "id":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Id"},
        "kind":{"type":"string","minLength":1},
        "run_id":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Id"},
        "recorded_at":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Timestamp"},
        "extensions":{"$ref":"#/$defs/Extensions"}
      }
    },
    "TextInterval":{
      "type":"object",
      "required":["unit","start","end"],
      "properties":{"unit":{"const":"unicode_scalar"},"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":0}},
      "additionalProperties":false
    },
    "ByteInterval":{
      "type":"object",
      "required":["unit","start","end"],
      "properties":{"unit":{"const":"byte"},"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":0}},
      "additionalProperties":false
    },
    "PathSelector":{
      "type":"object",
      "required":["scheme","value"],
      "properties":{"scheme":{"type":"string","minLength":1},"value":{"type":"string"}},
      "additionalProperties":false
    },
    "RegionSelector":{
      "oneOf":[
        {"type":"object","required":["region_kind","text"],"properties":{"region_kind":{"const":"text"},"text":{"$ref":"#/$defs/TextInterval"}},"additionalProperties":false},
        {"type":"object","required":["region_kind","bytes"],"properties":{"region_kind":{"const":"byte"},"bytes":{"$ref":"#/$defs/ByteInterval"}},"additionalProperties":false},
        {"type":"object","required":["region_kind","path"],"properties":{"region_kind":{"const":"structured"},"path":{"$ref":"#/$defs/PathSelector"}},"additionalProperties":false},
        {"type":"object","required":["region_kind","path","text"],"properties":{"region_kind":{"const":"structured_text"},"path":{"$ref":"#/$defs/PathSelector"},"text":{"$ref":"#/$defs/TextInterval"}},"additionalProperties":false}
      ]
    },
    "ArtifactScope":{
      "type":"object",
      "required":["artifact","representation_basis"],
      "properties":{
        "artifact":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
        "representation_basis":{"type":"string","minLength":1},
        "region":{"$ref":"#/$defs/RegionSelector"}
      },
      "additionalProperties":false
    },
    "Subject":{
      "type":"object",
      "required":["ref"],
      "properties":{
        "ref":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
        "representation_basis":{"type":"string","minLength":1},
        "region":{"$ref":"#/$defs/RegionSelector"}
      },
      "dependentRequired":{"region":["representation_basis"]},
      "additionalProperties":false
    },
    "TextRepresentation":{
      "type":"object","required":["representation_kind","text"],
      "properties":{"representation_kind":{"const":"text"},"text":{"type":"string"},"charset":{"const":"utf-8"},"media_type":{"type":"string","minLength":1}},
      "additionalProperties":false
    },
    "JsonRepresentation":{
      "type":"object","required":["representation_kind","value"],
      "properties":{"representation_kind":{"const":"json"},"value":true,"media_type":{"type":"string","minLength":1}},
      "additionalProperties":false
    },
    "BytesRepresentation":{
      "type":"object","required":["representation_kind","base64"],
      "properties":{"representation_kind":{"const":"bytes"},"base64":{"type":"string","contentEncoding":"base64"},"media_type":{"type":"string","minLength":1}},
      "additionalProperties":false
    },
    "Representation":{
      "oneOf":[{"$ref":"#/$defs/TextRepresentation"},{"$ref":"#/$defs/JsonRepresentation"},{"$ref":"#/$defs/BytesRepresentation"}]
    },
    "MetadataEntry":{
      "type":"object","required":["name","value","origin"],
      "properties":{"name":{"type":"string","minLength":1},"value":true,"origin":{"type":"string","minLength":1},"mapping_basis":{"type":"string","minLength":1}},
      "additionalProperties":false
    },
    "CaptureExtent":{"enum":["complete","partial","unknown"]},
    "LifecycleState":{"enum":["in_progress","terminal","unknown"]}
  }
}
