{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:c2atrace:schema:v0.1:tool",
  "title":"C2ATrace v0.1 Tool and Effect",
  "$defs":{
    "ToolProposal":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","output"],
          "properties":{
            "kind":{"const":"ToolProposal"},
            "output":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "ordinal":{"type":"integer","minimum":0},
            "tool_name":{"type":"string","minLength":1},
            "arguments":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/Representation"},
            "provider_tool_call_id":{"type":"string","minLength":1},
            "metadata":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/MetadataEntry"}}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "ToolDecision":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","subject","decision","asserted_by","policy"],
          "properties":{
            "kind":{"const":"ToolDecision"},
            "subject":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "decision":{"enum":["allow","deny","unknown"]},
            "asserted_by":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/PrincipalRef"},
            "policy":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/PolicyRef"},
            "basis":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}},
            "applicable_execution":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "ArgumentProvenance":{
      "type":"object",
      "required":["path","classification"],
      "properties":{
        "path":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/PathSelector"},
        "classification":{"enum":["model_supplied","application_supplied","mixed","unknown"]},
        "derivations":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}}
      },
      "additionalProperties":false
    },
    "ToolInvocation":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","tool_name"],
          "properties":{
            "kind":{"const":"ToolInvocation"},
            "tool_name":{"type":"string","minLength":1},
            "executable_target":{"type":"string","minLength":1},
            "arguments":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/Representation"},
            "argument_provenance":{"type":"array","items":{"$ref":"#/$defs/ArgumentProvenance"}},
            "execution_options":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/Representation"},
            "idempotency_key":{"type":"string","minLength":1},
            "preparation_transform":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "metadata":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/MetadataEntry"}}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "ToolExecution":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","invocation","lifecycle_state"],
          "properties":{
            "kind":{"const":"ToolExecution"},
            "invocation":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "lifecycle_state":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/LifecycleState"},
            "terminal_disposition":{"enum":["completed","failed","timeout","cancelled","interrupted","unknown"]},
            "retry_of":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "replay_of":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "duplicate_of":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "started_at":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Timestamp"},
            "ended_at":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Timestamp"},
            "metadata":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/MetadataEntry"}}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "ToolResult":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","execution","capture_extent"],
          "properties":{
            "kind":{"const":"ToolResult"},
            "execution":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "representation":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/Representation"},
            "capture_extent":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/CaptureExtent"},
            "reported_status":{"type":"string","minLength":1},
            "metadata":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/MetadataEntry"}}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "EffectObservation":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","basis","proposition"],
          "properties":{
            "kind":{"const":"EffectObservation"},
            "basis":{"enum":["execution_result","separate_observation","external_attestation","unknown"]},
            "proposition":{"type":"string","minLength":1},
            "execution":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "result":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "evidence":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}},
            "metadata":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/MetadataEntry"}}
          },
          "unevaluatedProperties":false
        }
      ]
    }
  }
}
