{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:c2atrace:schema:v0.1:adapter",
  "title":"C2ATrace v0.1 Adapter Declarations and Diagnostics",
  "$defs":{
    "CaptureDiagnostic":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","subject","slot","status"],
          "properties":{
            "kind":{"const":"CaptureDiagnostic"},
            "subject":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/Subject"},
            "slot":{"type":"string","minLength":1},
            "status":{"enum":["observed","partial","unavailable","unsupported","bypass_detected","unknown"]},
            "reason":{"type":"string","minLength":1},
            "basis":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}},
            "adapter_declaration":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "ProviderAdapterCapability":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","adapter_name","invocation_boundary","attempt_boundary","request_capture_levels","output_capture","streaming_output","privacy_profiles"],
          "properties":{
            "kind":{"const":"ProviderAdapterCapability"},
            "adapter_name":{"type":"string","minLength":1},
            "adapter_version":{"type":"string","minLength":1},
            "invocation_boundary":{"type":"string","minLength":1},
            "attempt_boundary":{"type":"string","minLength":1},
            "request_capture_levels":{"type":"array","minItems":1,"items":{"enum":["sdk_arguments","provider_payload","prepared_http_body"]},"uniqueItems":true},
            "output_capture":{"type":"boolean"},
            "streaming_output":{"type":"boolean"},
            "retry_visibility":{"enum":["direct","host_supplied","unknown","unsupported"]},
            "failover_visibility":{"enum":["direct","host_supplied","unknown","unsupported"]},
            "hedge_visibility":{"enum":["direct","host_supplied","unknown","unsupported"]},
            "privacy_profiles":{"type":"array","items":{"enum":["full","hash_only","hmac","redacted","mixed","unknown"]},"uniqueItems":true}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "ToolAdapterCapability":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","adapter_name","invocation_boundary","execution_boundary","result_boundary","proposal_association","decision_capture","streaming_result","effect_observation","privacy_profiles"],
          "properties":{
            "kind":{"const":"ToolAdapterCapability"},
            "adapter_name":{"type":"string","minLength":1},
            "adapter_version":{"type":"string","minLength":1},
            "invocation_boundary":{"type":"string","minLength":1},
            "execution_boundary":{"type":"string","minLength":1},
            "result_boundary":{"type":"string","minLength":1},
            "argument_path_schemes":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
            "proposal_association":{"type":"boolean"},
            "decision_capture":{"type":"boolean"},
            "streaming_result":{"type":"boolean"},
            "retry_visibility":{"enum":["direct","host_supplied","unknown","unsupported"]},
            "replay_visibility":{"enum":["direct","host_supplied","unknown","unsupported"]},
            "duplicate_visibility":{"enum":["direct","host_supplied","unknown","unsupported"]},
            "effect_observation":{"type":"array","items":{"enum":["execution_result","separate_observation","external_attestation"]},"uniqueItems":true},
            "privacy_profiles":{"type":"array","items":{"enum":["full","hash_only","hmac","redacted","mixed","unknown"]},"uniqueItems":true}
          },
          "unevaluatedProperties":false
        }
      ]
    }
  }
}
