{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2atrace:schema:v0.1:verifier",
  "title": "C2ATrace v0.1 Verification Report",
  "$defs": {
    "EvidenceBasis": {
      "type": "string",
      "pattern": "^(E1|E2|E3|E4|profile:.+)$"
    },
    "FindingDomain": {
      "enum": [
        "conformance",
        "resolution",
        "comparison",
        "cryptographic",
        "claim",
        "presence",
        "support",
        "conflict",
        "completeness"
      ]
    },
    "FindingStatus": {
      "enum": [
        "established",
        "valid",
        "invalid",
        "matched",
        "mismatched",
        "consistent",
        "resolved",
        "unresolved",
        "ambiguous",
        "asserted",
        "unknown",
        "unverified",
        "unsupported",
        "conflict",
        "present",
        "not_present",
        "withheld",
        "absent"
      ]
    },
    "VerificationFinding": {
      "type": "object",
      "required": [
        "finding_id",
        "check_id",
        "subject",
        "domain",
        "status",
        "evidence_bases",
        "mandatory"
      ],
      "properties": {
        "finding_id": {
          "$ref": "urn:c2atrace:schema:v0.1:primitives#/$defs/Id"
        },
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "$ref": "urn:c2atrace:schema:v0.1:verifier#/$defs/FindingSubject"
        },
        "domain": {
          "$ref": "#/$defs/FindingDomain"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        },
        "evidence_bases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceBasis"
          },
          "uniqueItems": true
        },
        "premises": {
          "type": "array",
          "items": {
            "$ref": "urn:c2atrace:schema:v0.1:primitives#/$defs/Id"
          },
          "uniqueItems": true
        },
        "mandatory": {
          "type": "boolean"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "prohibited_inferences": {
          "type": "array",
          "items": {
            "$ref": "urn:c2atrace:schema:v0.1:verifier#/$defs/ProhibitedInference"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "domain": {
                "const": "conformance"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "valid",
                  "invalid",
                  "unverified",
                  "unsupported"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "const": "resolution"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "resolved",
                  "unresolved",
                  "ambiguous",
                  "unverified",
                  "unsupported"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "const": "comparison"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "matched",
                  "mismatched",
                  "unverified",
                  "unsupported"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "const": "cryptographic"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "valid",
                  "invalid",
                  "unverified",
                  "unsupported",
                  "absent"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "const": "claim"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "established",
                  "asserted",
                  "unknown",
                  "unverified",
                  "conflict",
                  "unsupported"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "const": "presence"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "present",
                  "not_present",
                  "withheld",
                  "unknown"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "const": "support"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "established",
                  "unverified",
                  "unsupported"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "const": "conflict"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "consistent",
                  "conflict",
                  "unverified",
                  "unknown"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "const": "completeness"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "established",
                  "unknown",
                  "unverified",
                  "unsupported"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "EnvelopeResult": {
      "type": "object",
      "required": [
        "envelope_id",
        "key_resolution",
        "signature_status",
        "arp_binding"
      ],
      "properties": {
        "envelope_id": {
          "$ref": "urn:c2atrace:schema:v0.1:primitives#/$defs/Id"
        },
        "key_resolution": {
          "enum": [
            "resolved",
            "unresolved",
            "ambiguous",
            "unsupported"
          ]
        },
        "signature_status": {
          "enum": [
            "valid",
            "invalid",
            "unverified",
            "unsupported"
          ]
        },
        "arp_binding": {
          "enum": [
            "matched",
            "mismatched",
            "unverified",
            "unsupported"
          ]
        },
        "key_ref": {
          "$ref": "urn:c2atrace:schema:v0.1:primitives#/$defs/Id"
        },
        "finding_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:c2atrace:schema:v0.1:primitives#/$defs/Id"
          }
        }
      },
      "additionalProperties": false
    },
    "VerificationGoal": {
      "type": "object",
      "required": [
        "check_id",
        "mandatory"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "mandatory": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ProcessOutcome": {
      "enum": [
        "completed",
        "invalidity_detected",
        "incomplete_evaluation",
        "operational_error"
      ]
    },
    "VerificationReport": {
      "type": "object",
      "required": [
        "kind",
        "report_id",
        "verifier",
        "invocation",
        "findings",
        "envelope_results",
        "completeness",
        "process_outcome"
      ],
      "properties": {
        "kind": {
          "const": "VerificationReport"
        },
        "report_id": {
          "$ref": "urn:c2atrace:schema:v0.1:primitives#/$defs/Id"
        },
        "verifier": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "profiles": {
              "type": "array",
              "items": {
                "$ref": "urn:c2atrace:schema:v0.1:primitives#/$defs/ProfileId"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "invocation": {
          "type": "object",
          "required": [
            "receipt_ids",
            "goals",
            "capability_summary"
          ],
          "properties": {
            "receipt_ids": {
              "type": "array",
              "items": {
                "$ref": "urn:c2atrace:schema:v0.1:primitives#/$defs/Id"
              },
              "uniqueItems": true
            },
            "goals": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/VerificationGoal"
              }
            },
            "capability_summary": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VerificationFinding"
          }
        },
        "envelope_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnvelopeResult"
          }
        },
        "completeness": {
          "type": "object",
          "required": [
            "package_inventory",
            "reference_closure",
            "runtime_history"
          ],
          "properties": {
            "package_inventory": {
              "enum": [
                "established",
                "unknown",
                "unverified",
                "unsupported"
              ]
            },
            "reference_closure": {
              "enum": [
                "established",
                "unknown",
                "unverified",
                "unsupported"
              ]
            },
            "runtime_history": {
              "enum": [
                "established",
                "unknown",
                "unverified",
                "unsupported"
              ]
            }
          },
          "additionalProperties": false
        },
        "process_outcome": {
          "$ref": "#/$defs/ProcessOutcome"
        },
        "extensions": {
          "$ref": "urn:c2atrace:schema:v0.1:representation#/$defs/Extensions"
        }
      },
      "additionalProperties": false
    },
    "ProhibitedInference": {
      "type": "string",
      "pattern": "^P1(?::.+)?$"
    },
    "FindingSubject": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "subject_kind"
          ],
          "properties": {
            "subject_kind": {
              "const": "verification_invocation"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "subject_kind",
            "receipt_id"
          ],
          "properties": {
            "subject_kind": {
              "const": "receipt"
            },
            "receipt_id": {
              "$ref": "urn:c2atrace:schema:v0.1:primitives#/$defs/Id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "subject_kind",
            "receipt_id",
            "object_id"
          ],
          "properties": {
            "subject_kind": {
              "const": "object"
            },
            "receipt_id": {
              "$ref": "urn:c2atrace:schema:v0.1:primitives#/$defs/Id"
            },
            "object_id": {
              "$ref": "urn:c2atrace:schema:v0.1:primitives#/$defs/Id"
            },
            "expected_kind": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "subject_kind",
            "receipt_id",
            "envelope_id"
          ],
          "properties": {
            "subject_kind": {
              "const": "integrity_envelope"
            },
            "receipt_id": {
              "$ref": "urn:c2atrace:schema:v0.1:primitives#/$defs/Id"
            },
            "envelope_id": {
              "$ref": "urn:c2atrace:schema:v0.1:primitives#/$defs/Id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "subject_kind",
            "profile_id"
          ],
          "properties": {
            "subject_kind": {
              "const": "profile"
            },
            "profile_id": {
              "$ref": "urn:c2atrace:schema:v0.1:primitives#/$defs/ProfileId"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
