{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:c2atrace:schema:v0.1:reference",
  "title":"C2ATrace v0.1 References and Commitments",
  "$defs":{
    "Digest":{
      "type":"object",
      "required":["algorithm","value","representation_basis"],
      "properties":{
        "algorithm":{"type":"string","minLength":1},
        "value":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/EncodedValue"},
        "representation_basis":{"type":"string","minLength":1},
        "canonicalization_profile":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/ProfileId"}
      },
      "additionalProperties":false
    },
    "Commitment":{
      "type":"object",
      "required":["method","value","representation_basis"],
      "properties":{
        "method":{"type":"string","minLength":1},
        "value":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/EncodedValue"},
        "representation_basis":{"type":"string","minLength":1},
        "canonicalization_profile":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/ProfileId"},
        "key_ref":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Id"},
        "comparison_domain":{"type":"string","minLength":1},
        "profile_id":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/ProfileId"}
      },
      "additionalProperties":false
    },
    "LocalReference":{
      "type":"object",
      "required":["ref_type","id"],
      "properties":{
        "ref_type":{"const":"local"},
        "id":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Id"},
        "expected_kind":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    },
    "ExternalReference":{
      "type":"object",
      "required":["ref_type","receipt_id","id"],
      "properties":{
        "ref_type":{"const":"external"},
        "receipt_id":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Id"},
        "id":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/Id"},
        "expected_kind":{"type":"string","minLength":1},
        "target_payload_digest":{"$ref":"#/$defs/Digest"}
      },
      "additionalProperties":false
    },
    "Reference":{
      "oneOf":[
        {"$ref":"#/$defs/LocalReference"},
        {"$ref":"#/$defs/ExternalReference"}
      ]
    }
  }
}
