{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:c2atrace:schema:v0.1:transform",
  "title":"C2ATrace v0.1 Transform and Derivation",
  "$defs":{
    "TransformUse":{
      "type":"object",
      "required":["artifact","usage_role"],
      "properties":{
        "artifact":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
        "usage_role":{"enum":["data","control","mixed","unknown"]}
      },
      "additionalProperties":false
    },
    "Transform":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","operation","inputs","generated","selected"],
          "properties":{
            "kind":{"const":"Transform"},
            "operation":{"type":"string","minLength":1},
            "implementation":{"type":"string","minLength":1},
            "inputs":{"type":"array","items":{"$ref":"#/$defs/TransformUse"}},
            "generated":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}},
            "selected":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}},
            "metadata":{"type":"object","additionalProperties":true}
          },
          "unevaluatedProperties":false
        }
      ]
    },
    "Contributor":{
      "type":"object",
      "required":["scope"],
      "properties":{
        "scope":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/ArtifactScope"},
        "output_region":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/RegionSelector"},
        "mapping_profile":{"$ref":"urn:c2atrace:schema:v0.1:primitives#/$defs/ProfileId"}
      },
      "additionalProperties":false
    },
    "Derivation":{
      "allOf":[
        {"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/BaseRecord"},
        {
          "type":"object",
          "required":["kind","transform","target","contributors","precision"],
          "properties":{
            "kind":{"const":"Derivation"},
            "transform":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"},
            "target":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/ArtifactScope"},
            "contributors":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/Contributor"}},
            "precision":{"enum":["exact","partial"]},
            "generated_output_regions":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/RegionSelector"}},
            "unknown_origin_regions":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:representation#/$defs/RegionSelector"}},
            "evidence":{"type":"array","items":{"$ref":"urn:c2atrace:schema:v0.1:reference#/$defs/Reference"}}
          },
          "unevaluatedProperties":false
        }
      ]
    }
  }
}
