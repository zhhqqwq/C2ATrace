{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2atrace:conformance:v0.1:harness-input",
  "title": "C2ATrace v0.1 Semantic Verifier Harness Input",
  "type": "object",
  "required": [
    "verification_invocation_id",
    "primary_documents",
    "resolution_set",
    "supported_profiles",
    "goals"
  ],
  "properties": {
    "verification_invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "primary_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "resolution_set": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supported_profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verification_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_ref",
          "algorithm",
          "public_key_base64url"
        ],
        "properties": {
          "key_ref": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "const": "ed25519"
          },
          "public_key_base64url": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "hmac_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_ref",
          "method",
          "secret_hex"
        ],
        "properties": {
          "key_ref": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "const": "hmac-sha256"
          },
          "secret_hex": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "external_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
